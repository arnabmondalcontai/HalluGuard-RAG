# HalluGuard Environment Variables
# Copy this file to .env and fill in your keys

# Required: Groq API key for LLM generation and LLM-as-judge
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: HuggingFace token for gated model/dataset access
HUGGINGFACE_TOKEN=your_hf_token_here

# Optional: Weights & Biases for experiment tracking
# Get key at: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_key_here

# Optional: OpenAI API key (only if using OpenAI models)
OPENAI_API_KEY=optional_only_if_needed
